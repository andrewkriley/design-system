{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint \"scripts/**/*.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "validate:version": "node scripts/validate-version.mjs",
    "ci": "npm run lint && npm run format:check && npm run validate:manifests && npm run validate:version",
    "demo": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
